.9836379209143052, 0], [178, 815.9510414548052, 802.6417128638753, 0.9808769643899691, 0], [179, 814.9043246547748, 811.1005593996264, 0.984105451124014, 0], [180, 813.989838826129, 820.0276670064101, 0.9775238747459633, 0], [181, 813.021083314624, 828.6719735158317, 0.9826899592645016, 0], [182, 812.3675155890118, 838.0033661528072, 0.9771615285401224, 0], [183, 811.3061407561074, 846.8676637168381, 0.9889552597287352, 0], [184, 810.5081341248915, 855.5726651412964, 0.9806790705538637, 0], [185, 809.8301541384166, 864.3109989241763, 0.9850050781376916, 0], [186, 808.9748953475078, 874.2090618424131, 0.9760638977919067, 0], [187, 808.1979817509399, 882.5926728547893, 0.9842316457803866, 0], [188, 807.3802857160149, 892.1110964641889, 0.976213144732212, 0], [189, 806.2351564624375, 900.4292583609398, 0.9840910796649935, 0], [190, 805.761451481411, 910.0642774704532, 0.9753433417774262, 0], [191, 804.8610557613814, 919.0532104987091, 0.9869092184817407, 0]]}], "measures": [], "title": "Paper bag throw \u2014 air drag (blackboard grid)", "blurb": "Real 200 fps footage: a tumbling paper bag, tracked by colour; shows how air drag bends the path.", "tour": [{"title": "A tumbling paper bag", "seek": 12, "fit": true, "spot": ["canvas"], "text": "A crumpled paper bag thrown across a blackboard, filmed at <b>200 frames per second</b> (from the Mathe-AC maths workshop). The whole path is already tracked \u2014 the orange line. Press <b>Space</b> to play it slowly."}, {"title": "Tracking something that tumbles", "seek": 60, "zoom": [1186.2179328191837, 259.87534958189985, 3.0], "select": "Bag", "spot": ["points", "canvas"], "text": "The bag spins and changes shape every frame, so matching a picture of it (the normal tracker) fails. This point uses the <b>Blob</b> tracker (point settings \u2192 <i>Tracker</i>): it follows a patch of <b>colour</b> \u2014 the pale bag on the dark board \u2014 and takes its centre. Great for balls, coloured markers, anything that rotates."}, {"title": "Scale from the chalk grid", "seek": 0, "fit": true, "spot": ["calib", "canvas"], "text": "The yellow line spans <b>31 chalk squares</b> of 5 cm = 1.55 m. (0, 0) is where the bag leaves the hand; <b>x</b> points right, <b>y</b> up. So <i>Position Y</i> is height above the release point."}, {"title": "The path isn't a parabola", "seek": 191, "select": "Bag", "plot": {"q": "y", "show": ["Bag"]}, "spot": ["plots", "canvas"], "text": "Without air the path would be a symmetric arch. Here the way down is <b>much steeper</b> than the way up: air drag eats the sideways speed. It rises 0.60 m in 0.38 s but takes 0.58 s to come back down."}, {"title": "Vertical speed shows the drag", "select": "Bag", "plot": {"q": "vy", "show": ["Bag"]}, "seek": 75, "spot": ["plots"], "text": "Vertical speed over time. Going up it drops fast (gravity <i>and</i> drag both pull down: about <b>14 m/s\u00b2</b>). Coming down it gains speed slowly (drag now pushes up: only about <b>4 m/s\u00b2</b>). Without air both would be 9.81 m/s\u00b2."}, {"title": "Check: gravity at the top", "seek": 75, "select": "Bag", "plot": {"q": "ay", "show": ["Bag"]}, "spot": ["plots", "readout"], "text": "At the very top the bag moves sideways only, so drag can't push it up or down \u2014 only gravity acts vertically. Fitting the path there gives <b>9.1 m/s\u00b2</b> (between 8.1 and 10.0 depending on exactly which frames you fit), around the real 9.81: an independent check that the grid scale is right to within roughly 10%. The tumbling bag's centre wobbles, so this is as precise as it gets; Smoothing is set to 6 Hz to keep that wobble out of the graphs."}, {"title": "Speed", "select": "Bag", "plot": {"q": "speed", "show": ["Bag"]}, "spot": ["plots"], "text": "It leaves the hand at about <b>5.1 m/s</b>, slows to its minimum just after the top, and falls at about 2.5 m/s at the end \u2014 heading for a terminal speed where drag balances its weight."}, {"title": "Scale from gravity (no ruler needed)", "seek": 75, "spot": ["calib"], "text": "No ruler in your shot? Select a point that's flying, put the playhead in the flight (or mark it with <b>[</b> <b>]</b>) and click <b>Scale from gravity</b>: the app fits the fall and uses 9.81 m/s\u00b2 as the ruler. Only accurate when air drag is small (a ball, not a paper bag!)."}], "stab": {}}